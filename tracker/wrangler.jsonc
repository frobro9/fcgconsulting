{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcg-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fcg-tracker",
      "database_id": "10779bee-fbeb-4cf0-ad9b-e3493c5eaab3"
    }
  ],

  // Email Routing must be enabled on fcgconsulting.ca, and the destination
  // address below must be added + verified there
  // (Email > Email Routing > Destination addresses).
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "camfrohar@fcgconsulting.ca"
    }
  ],

  // Price checks run every 6 hours.
  "triggers": { "crons": ["0 */6 * * *"] },

  // Bound as a Worker custom domain (the fcgconsulting.ca zone is on this account).
  // The marketing site's "Client Portal" link points here.
  "routes": [{ "pattern": "portal.fcgconsulting.ca", "custom_domain": true }],

  "vars": {
    // Any address on a domain with Email Routing enabled on this account.
    "ALERT_FROM": "alerts@fcgconsulting.ca",
    // Must match the verified `destination_address` above.
    "ALERT_TO": "camfrohar@fcgconsulting.ca",
    "SCRAPER_API_PROVIDER": "scrapingbee"
  }

  // Secrets — set with `wrangler secret put <NAME>` (never commit these):
  //   ADMIN_USERNAME       e.g. admin
  //   ADMIN_PASSWORD       e.g. admin  (weak — change after first login)
  //   SESSION_SECRET       long random string
  //   CRON_TOKEN           random string; guards POST /cron/run
  //   SCRAPER_API_KEY      optional; enables JS-rendering scrape fallback
}
