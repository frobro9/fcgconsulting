{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcg-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fcg-tracker",
      "database_id": "10779bee-fbeb-4cf0-ad9b-e3493c5eaab3"
    }
  ],

  // Alerts go out via Resend (RESEND_API_KEY secret) because fcgconsulting.ca
  // runs Microsoft 365 mail — enabling Cloudflare Email Routing would replace
  // its MX and break inboxes. This send_email binding is only the fallback used
  // when RESEND_API_KEY is unset; it stays inert without Email Routing.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "camfrohar@fcgconsulting.ca"
    }
  ],

  // Price checks run every 6 hours.
  "triggers": { "crons": ["0 */6 * * *"] },

  // fcgconsulting.ca is a Cloudflare zone, so `wrangler deploy` binds this
  // custom domain (auto SSL). The marketing site's "Client Portal" link points here.
  "routes": [{ "pattern": "portal.fcgconsulting.ca", "custom_domain": true }],

  "vars": {
    // Resend sender. fcgconsulting.ca is a verified sending domain in Resend
    // (DKIM resend._domainkey + send.fcgconsulting.ca SPF/MX — M365 MX untouched).
    "ALERT_FROM": "alerts@fcgconsulting.ca",
    "ALERT_TO": "camfrohar@fcgconsulting.ca",
    // Headless-browser fallback for blocked / JS-only sites.
    //   cloudflare  -> Cloudflare Browser Rendering (free tier, in-ecosystem)
    //   scrapingbee | scraperapi | scrapingant -> third-party scraping APIs
    "SCRAPER_API_PROVIDER": "cloudflare",
    "SCRAPER_ACCOUNT_ID": "cf1de50389d6ef075bafb97c3ed4a81c"
  }

  // Secrets — set with `wrangler secret put <NAME>` (never commit these):
  //   ADMIN_USERNAME       e.g. admin
  //   ADMIN_PASSWORD       e.g. admin  (weak — change after first login)
  //   SESSION_SECRET       long random string
  //   CRON_TOKEN           random string; guards POST /cron/run
  //   RESEND_API_KEY       enables the Resend alert path
  //   SCRAPER_API_KEY      enables the render fallback. For provider "cloudflare"
  //                        this is a Cloudflare API token with Browser Rendering
  //                        permission; for the others it's that service's key.
}
